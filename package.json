  "scripts": {
    "test": "node test/rules.test.mjs && node test/dates.test.mjs && node test/domain.test.mjs && node test/checklist.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-storage-domain": ">=0.0.1-rc.1 <0.3.0-0 || >=0.2.1-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc.1 <0.3.0-0 || >=0.2.1-rc.1 <0.3.0-0"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
