{
  "name": "dsh-insurance-advisor",
  "version": "0.1.0",
  "description": "Insurance advisor agent preset for individual agents: suitability matching, policy ledger, and sales-recording checks.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "insurance",
    "agent-preset",
    "compliance"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MagicTangOps/dsh-insurance-advisor.git"
  },
  "homepage": "https://github.com/MagicTangOps/dsh-insurance-advisor#readme",
  "engines": {
    "dsh": ">=0.2.1-rc.1 <0.3.0-0"
  },
  "exports": {
    ".": "./src/index.js",
    "./preset": "./src/index.js",
    "./suitability": "./src/suitability/index.js",
    "./crm": "./src/crm/index.js",
    "./dual-record": "./src/dual-record/index.js",
    "./suitability/rules": "./src/suitability/rules.js",
    "./crm/dates": "./src/crm/dates.js",
    "./crm/domain": "./src/crm/domain.js",
    "./dual-record/checklist": "./src/dual-record/checklist.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "src/**/*.js",
    "skills/**/SKILL.md",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
